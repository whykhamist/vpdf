{
  "name": "@whykhamist/vpdf",
  "version": "3.0.0",
  "description": "Production-ready Vue 3 PDF viewer built on PDF.js",
  "type": "module",
  "license": "MIT",
  "author": "vpdf",
  "keywords": [
    "vue",
    "pdf",
    "pdf.js",
    "pdfjs",
    "viewer",
    "annotations"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/vpdf.js",
  "module": "./dist/vpdf.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vpdf.js"
    },
    "./style.css": "./dist/vpdf.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && npm run copy-assets",
    "copy-assets": "node ./scripts/copy-assets.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.16.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.17",
    "vue-tsc": "^3.0.3"
  }
}
